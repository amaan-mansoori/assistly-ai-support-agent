# Copy to .env for local development; never commit the resulting .env file.

# Dataset download, if Kaggle access is needed
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional live generation and evaluation providers
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=
SUPPORT_AGENT_PROVIDER=gemini
SUPPORT_AGENT_MODEL=gemini-2.0-flash

# Platform defaults for local development
APP_ENV=development
POSTGRES_DB=support_agent
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=local-dev-password-change-me
JWT_SECRET=local-development-secret-change-before-deployment-32chars
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000
RETRIEVER_BACKEND=tfidf
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HYBRID_LEXICAL_WEIGHT=0.5
HYBRID_SEMANTIC_WEIGHT=0.5
# Set to 1 to install the optional CPU-only semantic embedding dependencies.
# INSTALL_SEMANTIC_EMBEDDINGS=1
SUPPORT_AGENT_TIMEOUT_SECONDS=30
SUPPORT_AGENT_MAX_RETRIES=2
SUPPORT_AGENT_HISTORY_WINDOW=12
SUPPORT_AGENT_HISTORY_MAX_CHARS=12000
LOG_LEVEL=INFO

# Optional for running Redis outside Docker
# REDIS_URL=redis://localhost:6379/0
# Optional for non-Docker PostgreSQL; when unset the API uses local SQLite.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/support_agent
# Set when building the frontend outside Docker. Production requires HTTPS.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
